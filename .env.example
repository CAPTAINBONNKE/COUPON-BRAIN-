# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to run against the local embedded Postgres (PGlite)
# in ./.data/pglite. One schema, two drivers — the SQL is identical either way.
#
# To point at Supabase instead:
#   1. Supabase Dashboard → Project Settings → Database → Connection string
#   2. Use the SESSION POOLER / "Transaction pooler" URL (port 6543) for the app.
#   3. Use the DIRECT connection (port 5432) for `npm run db:migrate`.
#   4. Optional: add ?sslmode=require (Supabase requires TLS).
#
# Example:
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
#
# NEVER expose the service_role key or any anon key prefixed with NEXT_PUBLIC_
# unless you fully understand that it becomes public. This app is server-only
# today, so no Supabase browser keys are used at all.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# ANALYTICS / ANTI-ABUSE
# ─────────────────────────────────────────────────────────────────────────────
# Server-side salt for hashing the anonymous visitor id used by coupon analytics.
# Keep this secret and stable — changing it resets anonymous attribution.
VISITOR_HASH_SALT=change-me-in-production
